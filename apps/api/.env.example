# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/restrovia_cloud

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored API key and 2FA secret unreadable; keep an offline backup.
MASTER_KEY=

# Used only by `npm run db:seed` (refuses to run in production).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Ed25519 private key that signs POS licences (PKCS#8 DER, base64). Generate with:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({format:'der',type:'pkcs8'}).toString('base64'));console.log(k.publicKey.export({format:'der',type:'spki'}).toString('base64'))"
# The second line printed is the public key that goes into restrovia-pos (shared/restrovia-licence.ts).
# Losing this key means every POS needs an update with a new public key.
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=k1

# Owner emails. `outbox` keeps them in memory and, in development, prints them (links included) to
# the log. Production: EMAIL_PROVIDER=resend with an API key from resend.com.
EMAIL_PROVIDER=outbox
EMAIL_API_KEY=
EMAIL_FROM=Restrovia <no-reply@restrovia.shop>
# Base of the links in owner emails: the owner portal.
OWNER_APP_URL=http://localhost:3200
API_PUBLIC_URL=http://localhost:4000

# The marketing site's enquiry form posts to /api/public/leads. List the site origins allowed to
# call it (comma separated), and the inbox that should be emailed about each new enquiry.
PUBLIC_FORM_ORIGINS=https://restrovia.shop,https://www.restrovia.shop
LEADS_NOTIFY_EMAIL=

# WhatsApp welcome offer for new leads who agreed to messages. `outbox` keeps messages in memory;
# `meta` sends through the WhatsApp Cloud API with a permanent system-user token. The offer is
# only sent once WHATSAPP_LEAD_OFFER_IMAGE_URL points at a public JPG or PNG banner.
WHATSAPP_PROVIDER=outbox
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_LEAD_OFFER_TEMPLATE=restrovia_lead_offer
WHATSAPP_LEAD_OFFER_IMAGE_URL=

# Tests wipe this database; its name must end in _test.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/restrovia_cloud_test
