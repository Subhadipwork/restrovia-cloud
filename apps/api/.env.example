# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres@127.0.0.1:5432/restrovia_cloud

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Losing this key makes every stored API key and 2FA secret unreadable; keep an offline backup.
MASTER_KEY=

# Used only by `npm run db:seed` (refuses to run in production).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Ed25519 private key that signs POS licences (PKCS#8 DER, base64). Generate with:
#   node -e "const k=require('crypto').generateKeyPairSync('ed25519');console.log(k.privateKey.export({format:'der',type:'pkcs8'}).toString('base64'));console.log(k.publicKey.export({format:'der',type:'spki'}).toString('base64'))"
# The second line printed is the public key that goes into restrovia-pos (shared/restrovia-licence.ts).
# Losing this key means every POS needs an update with a new public key.
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=k1

# Tests wipe this database; its name must end in _test.
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/restrovia_cloud_test
