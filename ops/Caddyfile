{
	email {$ACME_EMAIL}
}

# Sync API for POS machines (cloud.restrovia.in, or staging-cloud.restrovia.in on staging).
{$API_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Same limit as the API: a rejected batch would be retried by the POS forever.
	request_body {
		max_size 5MB
	}
	# The admin and owner APIs are served on their own sites only.
	respond /api/admin/* 404
	respond /api/owner/* 404
	reverse_proxy api:4000
}

# Admin panel (admin.restrovia.in): its API goes straight to the API container.
{$ADMIN_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	handle /api/admin/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy admin:3100
	}
}

# Restrovia POS update files (updates.restrovia.shop), uploaded into ops/updates by the POS repo's
# brand/scripts/publish-update.sh. No directory listing.
{$UPDATES_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# The POS learns about new versions from latest*.yml; a cached copy would hide a release.
	@feed path *.yml
	header @feed Cache-Control "no-cache"
	root * /srv/updates
	file_server
}

# Phase 4: app.restrovia.in → /api/owner/* to api:4000, everything else to the owner app.
