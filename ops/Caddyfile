{
	email {$ACME_EMAIL}
	# Cloudflare sends the visitor's address in CF-Connecting-IP. Trust it only on connections from
	# Cloudflare's ranges (https://www.cloudflare.com/ips-v4 and /ips-v6), so the API's per-IP
	# limits and audit log see visitors rather than Cloudflare. Direct visitors keep their own IP.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
	}
}

# Sync API for POS machines (cloud.restrovia.in, or staging-cloud.restrovia.in on staging).
{$API_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# Same limit as the API: a rejected batch would be retried by the POS forever.
	request_body {
		max_size 5MB
	}
	# The admin and owner APIs are served on their own sites only.
	respond /api/admin/* 404
	respond /api/owner/* 404
	reverse_proxy api:4000 {
		header_up X-Forwarded-For {client_ip}
	}
}

# Admin panel (admin.restrovia.in): its API goes straight to the API container.
{$ADMIN_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	handle /api/admin/* {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy admin:3100
	}
}

# Owner portal (app.restrovia.in): its API goes straight to the API container.
{$OWNER_HOST} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	handle /api/owner/* {
		reverse_proxy api:4000 {
			header_up X-Forwarded-For {client_ip}
		}
	}
	handle {
		reverse_proxy owner:3200
	}
}

# Restrovia POS update files (updates.restrovia.in), uploaded into ops/updates by the POS repo's
# brand/scripts/publish-update.sh. No directory listing.
{$UPDATES_HOST} {
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	# The POS learns about new versions from latest*.yml; a cached copy would hide a release.
	@feed path *.yml
	header @feed Cache-Control "no-cache"
	root * /srv/updates
	file_server
}
