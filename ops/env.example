# Copy to ops/.env on the server (chmod 600). Never commit the real file.

# Sites. DNS A records for both must point at this server before the first start.
API_HOST=cloud.restrovia.shop
ADMIN_HOST=admin.restrovia.shop
# Mapbox PUBLIC token (pk.) for the admin lead map, baked in when the admin image is built.
# Never a secret (sk.) token: it ships to the browser. Restrict it to ADMIN_HOST in Mapbox.
MAPBOX_PUBLIC_TOKEN=
# Restrovia POS update files (installers and latest*.yml), served from ops/updates.
UPDATES_HOST=updates.restrovia.shop
# Let's Encrypt account email for the HTTPS certificates.
ACME_EMAIL=

# openssl rand -hex 24 (hex: it goes inside the database URL)
POSTGRES_PASSWORD=
# 32 random bytes: openssl rand -base64 32. Encrypts POS API keys; losing it breaks every POS.
MASTER_KEY=
# Ed25519 private key whose public key is built into Restrovia POS (LICENCE_PUBLIC_KEYS).
# Losing it means shipping a new POS release with a new key.
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=k1
# Owner portal emails (sign-up, password reset). Without these, owners can't confirm their email.
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Restrovia <no-reply@restrovia.shop>
OWNER_APP_URL=https://app.restrovia.shop
ADMIN_APP_URL=https://admin.restrovia.shop
