# Copy to ops/.env on the server (chmod 600). Never commit the real file.

# Sites. DNS A records for both must point at this server before the first start.
API_HOST=cloud.restrovia.in
ADMIN_HOST=admin.restrovia.in
# Let's Encrypt account email for the HTTPS certificates.
ACME_EMAIL=

# openssl rand -hex 24 (hex: it goes inside the database URL)
POSTGRES_PASSWORD=
# 32 random bytes: openssl rand -base64 32. Encrypts POS API keys; losing it breaks every POS.
MASTER_KEY=
# Ed25519 private key whose public key is built into Restrovia POS (LICENCE_PUBLIC_KEYS).
# Losing it means shipping a new POS release with a new key.
LICENCE_SIGNING_KEY=
LICENCE_KEY_ID=k1
